{
  "name": "aqoon-unefd",
  "version": "1.0.0",
  "description": "Aqoon UNEFD — le campus connecté de Djibouti",
  "scripts": {
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "db:migrate": "cd server && npm run db:migrate",
    "db:seed": "cd server && npm run db:seed",
    "db:studio": "cd server && npm run db:studio",
    "db:reset": "cd server && npm run db:reset",
    "start": "cd server && npm start",
    "db:deploy": "cd server && npm run db:deploy",
    "test": "cd server && npm test"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
