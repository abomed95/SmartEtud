# --- Base de données (PostgreSQL 14+) ---------------------------------------
DATABASE_URL="postgresql://postgres:password@localhost:5432/aqoon?schema=public"

# --- Sécurité ----------------------------------------------------------------
# 32 caractères minimum en production :  openssl rand -hex 48
JWT_SECRET="change-moi-en-production"
JWT_EXPIRES_IN="7d"

# --- Serveur -----------------------------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_URL="http://localhost:5173"
APP_NAME="Aqoon UNEFD"
DEVISE="FDJ"

# --- Assistant IA (Claude) ---------------------------------------------------
# Vide = mode hors-ligne (réponses factuelles sans IA). Clé : https://console.anthropic.com
ANTHROPIC_API_KEY=""
ASSISTANT_MODEL="claude-opus-5-5"
ASSISTANT_EFFORT="low"

# --- Vidéos -----------------------------------------------------------------
# Vide = stockage disque local (développement). En production : nom du bucket GCS.
GCS_BUCKET=""
MAX_VIDEO_MO=500
